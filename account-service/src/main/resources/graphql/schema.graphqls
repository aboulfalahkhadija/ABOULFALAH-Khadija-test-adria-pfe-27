type Query {
    accounts: [Account!]!
    accountById(id: ID!): Account
}

type Mutation {
    createAccount(
        customerReference: String!
        currency: String!
        balance: Float!
        status: AccountStatus
    ): Account!
    updateAccountStatus(id: ID!, status: AccountStatus!): Account!
    debitAccount(id: ID!, amount: Float!): Account!
    creditAccount(id: ID!, amount: Float!): Account!
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}
